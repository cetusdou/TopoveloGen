{
  "figure_id": "fig_bench_velo_test",
  "title": "Velocity method benchmark",
  "out_dir": "data/results/benchmark_velo_test",
  "data_subdir": "data",
  "figures_subdir": "figures",
  "formats": ["png", "pdf"],

  "bench_root": "benchmark_velo_test",
  "method_order": ["deepvelo", "unitvelo", "scvelo"],

  "method_dirs": {
    "deepvelo": "benchmark_velo_test/results/deepvelo",
    "unitvelo": "benchmark_velo_test/results/unitvelo",
    "scvelo": "benchmark_velo_test/results/scvelo"
  },

  "method_vkeys": {
    "deepvelo": ["deepvelo_velo", "velocity"],
    "unitvelo": ["velocity"],
    "scvelo": ["velocity"]
  },

  "colors": {
    "deepvelo": "#0072B2",
    "unitvelo": "#D55E00",
    "scvelo": "#009E73"
  },

  "color_key": "true_time",
  "prefer_vis_h5ad": true,

  "stream": {
    "legend_loc": null,
    "density": 1.2,
    "linewidth": 0.9,
    "arrowsize": 0.9,
    "size": 6,
    "alpha": 0.5,
    "colorbar": false,
    "show": false
  },

  "hist": {
    "bins": 60,
    "alpha": 0.7
  },
  "unitvelo_mse_scale": 10.0,

  "projection_masking": {
    "bins": 60,
    "xlim": [-1.05, 1.05]
  }
}

